{
  "server": {
    "port": 3000,
    "host": "0.0.0.0",
    "requestTimeout": 30000
  },
  "mcpServers": [
    {
      "id": "example-server",
      "url": "http://localhost:3001",
      "timeout": 30000,
      "transport": "auto",
      "comment": "Transport auto-detects HTTP or SSE based on Content-Type header"
    },
    {
      "id": "sse-server-example",
      "url": "https://example.com/mcp",
      "timeout": 30000,
      "transport": "sse",
      "sseOptions": {
        "sseEventFilter": ["message"],
        "sseBufferSize": 10
      },
      "comment": "Example SSE server configuration"
    }
  ],
  "filterRules": [
    {
      "id": "example-filter",
      "name": "Example filter for demonstration",
      "enabled": true,
      "condition": {
        "type": "jsonpath",
        "path": "$.method",
        "operator": "equals",
        "value": "tools/list"
      },
      "action": {
        "type": "modify",
        "operations": [
          {
            "type": "add",
            "path": "$.result.filtered",
            "value": true
          }
        ]
      }
    }
  ]
}
