{
  "server": {
    "port": 8080,
    "host": "0.0.0.0"
  },
  "logging": {
    "level": "info"
  },
  "mcpServers": [
    {
      "id": "default-server",
      "url": "http://mcp-server:5000",
      "timeout": 30000,
      "retryPolicy": {
        "maxRetries": 3,
        "backoffMs": 100
      }
    }
  ],
  "filters": [],
  "transformations": [],
  "plugins": {
    "enabled": true,
    "directory": "/app/plugins",
    "timeout": 5000
  },
  "dynamicBackendRouting": {
    "enabled": true,
    "headerName": "APIM-PROXIED-MCP-HOST",
    "allowlist": [
      "*.internal.mycompany.com",
      "*.k8s.svc.cluster.local",
      "mcp-prod.example.com",
      "mcp-staging.example.com"
    ],
    "denyByDefault": true,
    "defaultPort": 443,
    "allowIpAddresses": false,
    "allowInsecureProtocol": false
  }
}
