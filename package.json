{
  "name": "hi-mcp-filter",
  "version": "0.1.0",
  "description": "MCP Response Filter Proxy - Filter and modify MCP server responses",
  "main": "dist/proxy/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "mcp",
    "proxy",
    "filter",
    "transform",
    "azure"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "chokidar": "^3.5.3",
    "dotenv": "^16.3.1",
    "eventsource-parser": "^3.0.6",
    "fastify": "^5.7.3",
    "jsonata": "^2.0.0",
    "jsonpath-plus": "^10.3.0",
    "pino": "^8.17.2",
    "uuid": "^13.0.0",
    "vm2": "^3.10.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
