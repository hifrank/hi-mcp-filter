{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Filter Proxy Configuration",
  "type": "object",
  "required": ["server"],
  "properties": {
    "server": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Port to listen on"
        },
        "host": {
          "type": "string",
          "default": "0.0.0.0",
          "description": "Host address to bind to"
        },
        "requestTimeout": {
          "type": "integer",
          "minimum": 1000,
          "default": 30000,
          "description": "Request timeout in milliseconds"
        }
      }
    },
    "mcpServers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique server identifier"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Backend MCP server URL"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1000,
            "default": 10000,
            "description": "Backend request timeout in milliseconds"
          },
          "transport": {
            "type": "string",
            "enum": ["http", "sse", "auto"],
            "default": "auto",
            "description": "Transport mode: http (JSON-RPC), sse (Server-Sent Events), or auto (detect from Content-Type)"
          },
          "sseOptions": {
            "type": "object",
            "properties": {
              "sseEventFilter": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "default": ["message"],
                "description": "Event types to process (default: ['message'])"
              },
              "sseBufferSize": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "default": 10,
                "description": "Maximum events to buffer before processing"
              },
              "sseStreamingMode": {
                "type": "boolean",
                "default": false,
                "description": "Enable pass-through SSE streaming to client (P3 feature)"
              }
            }
          }
        }
      },
      "default": []
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "condition", "action"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique filter rule ID"
          },
          "name": {
            "type": "string",
            "description": "Human-readable filter name"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "condition": {
            "type": "object",
            "required": ["field", "operator", "value"],
            "properties": {
              "field": {
                "type": "string",
                "description": "JSONPath expression"
              },
              "operator": {
                "type": "string",
                "enum": ["equals", "contains", "matches", "exists", "not"]
              },
              "value": {}
            }
          },
          "action": {
            "type": "string",
            "enum": ["allow", "drop"]
          },
          "composition": {
            "type": "string",
            "enum": ["AND", "OR", "NONE"],
            "default": "NONE"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        }
      },
      "default": []
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "expression"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique transformation ID"
          },
          "name": {
            "type": "string",
            "description": "Human-readable transformation name"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "expression": {
            "type": "string",
            "description": "JSONata expression"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "onError": {
            "type": "string",
            "enum": ["skip", "passthrough", "fail"],
            "default": "passthrough"
          }
        }
      },
      "default": []
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "filePath"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Plugin identifier"
          },
          "version": {
            "type": "string",
            "description": "Plugin version"
          },
          "filePath": {
            "type": "string",
            "description": "Path to plugin JavaScript file"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "errorBehavior": {
            "type": "string",
            "enum": ["fail-open", "fail-secure", "retry"],
            "default": "fail-open"
          },
          "retryAttempts": {
            "type": "integer",
            "minimum": 1,
            "default": 3
          },
          "timeout": {
            "type": "integer",
            "minimum": 100,
            "default": 5000
          }
        }
      },
      "default": []
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error"],
          "default": "info"
        },
        "format": {
          "type": "string",
          "enum": ["json", "pretty"],
          "default": "json"
        }
      }
    },
    "hotReload": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "debounceMs": {
          "type": "integer",
          "minimum": 100,
          "default": 1000
        }
      }
    },
    "dynamicBackendRouting": {
      "type": "object",
      "required": ["enabled", "headerName", "allowlist", "denyByDefault"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable dynamic backend routing via request header"
        },
        "headerName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$",
          "default": "APIM-PROXIED-MCP-HOST",
          "description": "HTTP header name to read backend hostname from"
        },
        "allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of allowed backend hostnames (supports wildcards like *.internal.example.com)"
        },
        "denyByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Deny backends not in allowlist (recommended: true for security)"
        },
        "defaultPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 443,
          "description": "Default port if not specified in header"
        },
        "allowIpAddresses": {
          "type": "boolean",
          "default": false,
          "description": "Allow IP addresses in allowlist and header"
        },
        "allowInsecureProtocol": {
          "type": "boolean",
          "default": false,
          "description": "Allow HTTP protocol (MVP: always false, HTTPS only)"
        }
      }
    }
  }
}
